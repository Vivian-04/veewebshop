# --- Database (Supabase OR Neon — any Postgres connection string works) ---
# Supabase: Project Settings > Database > Connection string (use the "Transaction pooler" URI)
# Neon:     Dashboard > Connection Details (pooled connection string)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth.js (email + password sign-in works with just AUTH_SECRET) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Optional: Google sign-in. Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Mailgun ---
MAILGUN_API_KEY=""
MAILGUN_DOMAIN="mg.yourdomain.com"
# US region: https://api.mailgun.net   EU region: https://api.eu.mailgun.net
MAILGUN_API_BASE="https://api.mailgun.net"
MAIL_FROM="Shop <orders@mg.yourdomain.com>"

# Used for links in emails
APP_URL="http://localhost:3000"

# Optional (dev only): let other devices on your Wi-Fi use the dev server, e.g. "192.168.1.20"
DEV_ALLOWED_ORIGINS=""

# Shop admins (comma-separated emails): can open /admin and receive new-order emails
ADMIN_EMAILS=""
